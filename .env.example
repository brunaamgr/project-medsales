APP_NAME=MedSales
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

# Local: pinhabel.localhost:8000. Produção: medsalesbr.com
TENANCY_BASE_DOMAIN=localhost
PLATFORM_HOST=admin.localhost

HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

# Local rápido: sqlite. Destino: mysql (docker compose up -d)
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=medsales
# DB_USERNAME=medsales
# DB_PASSWORD=

# SESSION_DOMAIN fica nulo: cookie só do host do tenant.
# Produção (HTTPS): SESSION_COOKIE=__Host-medsales_session e SESSION_SECURE_COOKIE=true
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ABSOLUTE_MINUTES=720
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=medsales_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
